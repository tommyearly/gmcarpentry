NEXT_PUBLIC_SITE_URL=https://gmcarpentry.ie

# Public contact details
NEXT_PUBLIC_PHONE=087 615 9429
NEXT_PUBLIC_EMAIL=info@gmcarpentry.ie

# Private form inbox (Resend delivers here). Never use NEXT_PUBLIC_ for this.
CONTACT_TO_EMAIL=info@gmcarpentry.ie

# Must be a verified sender on your Resend domain
EMAIL_FROM="GM Carpentry & Construction <info@gmcarpentry.ie>"
EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Optional analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# Google reCAPTCHA v3 — https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Dev-only design control panel
NEXT_PUBLIC_DESIGN_PANEL=false
